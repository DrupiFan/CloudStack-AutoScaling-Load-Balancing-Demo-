[Unit]
Description=ASG Monitoring Dashboard
After=network.target

[Service]
User=root
WorkingDirectory=/opt/cloudstack-asg-demo/monitor-app
ExecStart=/opt/cloudstack-asg-demo/monitor-app/venv/bin/python3 /opt/cloudstack-asg-demo/monitor-app/app.py
Restart=always
RestartSec=3
Environment=PORT=5000

[Install]
WantedBy=multi-user.target
